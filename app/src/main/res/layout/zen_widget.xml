<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/zen_widget_bg"
    android:padding="14dp">

    <!-- Cabecera: selector de modo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/widget_mode_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/zen_widget_step_bg"
            android:text="‹"
            android:textColor="@color/widget_accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_title"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_subtitle"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/widget_mode_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/zen_widget_step_bg"
            android:text="›"
            android:textColor="@color/widget_accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Steppers: horas y minutos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_hours_label"
                android:textColor="@color/widget_muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/widget_hour_dec"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/zen_widget_step_bg"
                    android:text="−"
                    android:textColor="@color/widget_accent"
                    android:textSize="18sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/widget_hour_value"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/widget_hour_default"
                    android:textColor="@color/widget_text"
                    android:textSize="28sp"
                    android:textStyle="normal" />

                <Button
                    android:id="@+id/widget_hour_inc"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/zen_widget_step_bg"
                    android:text="+"
                    android:textColor="@color/widget_accent"
                    android:textSize="18sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_colon"
            android:textColor="@color/widget_muted"
            android:textSize="26sp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_minutes_label"
                android:textColor="@color/widget_muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/widget_min_dec"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/zen_widget_step_bg"
                    android:text="−"
                    android:textColor="@color/widget_accent"
                    android:textSize="18sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/widget_min_value"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/widget_min_default"
                    android:textColor="@color/widget_text"
                    android:textSize="28sp" />

                <Button
                    android:id="@+id/widget_min_inc"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/zen_widget_step_bg"
                    android:text="+"
                    android:textColor="@color/widget_accent"
                    android:textSize="18sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Botón iniciar -->
    <Button
        android:id="@+id/widget_btn_start"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/zen_widget_btn_bg"
        android:text="@string/widget_start"
        android:textColor="@color/widget_on_accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:minHeight="0dp"
        android:minWidth="0dp" />

    <!-- Frase + acceso a notas -->
    <TextView
        android:id="@+id/widget_open_notes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_open_notes"
        android:textColor="@color/widget_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
